function translateMenu(menu) {
    const labels = new Map([
        ['File', '文件'],
        ['Edit', '编辑'],
        ['View', '视图'],
        ['Window', '窗口'],
        ['Help', '帮助'],
        ['New Window', '新建窗口'],
        ['New Conversation', '新建对话'],
        ['Check for Updates', '检查更新'],
        ['Checking for Updates...', '正在检查更新...'],
        ['Downloading Update...', '正在下载更新...'],
        ['Restart to Update', '重启并更新'],
        ['Docs', '文档'],
        ['Toggle Developer Tools', '切换开发者工具'],
        ['Reload', '重新加载'],
        ['Force Reload', '强制重新加载'],
        ['Actual Size', '实际大小'],
        ['Zoom In', '放大'],
        ['Zoom Out', '缩小'],
        ['Toggle Full Screen', '切换全屏'],
        ['Minimize', '最小化'],
        ['Close', '关闭'],
        ['Quit', '退出'],
        ['Undo', '撤销'],
        ['Redo', '重做'],
        ['Cut', '剪切'],
        ['Copy', '复制'],
        ['Paste', '粘贴'],
        ['Select All', '全选'],
    ]);
    const visit = (item) => {
        const label = item.label;
        if (label && labels.has(label)) {
            item.label = labels.get(label);
        }
        item.submenu?.items.forEach(visit);
    };
    menu.items.forEach(visit);
}
